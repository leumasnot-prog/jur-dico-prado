# MCP Juridico Brasil - variaveis de ambiente
# Copie para .env e preencha conforme necessario.
# NUNCA versione o arquivo .env real.

# =====================================================
# DataJud CNJ (Fase 1 - MVP)
# =====================================================
# Chave publica divulgada na wiki do CNJ. Pode ser rotacionada pelo CNJ sem aviso.
# Sempre consulte: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# URL base da API DataJud (nao altere sem necessidade)
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# =====================================================
# Provider Comercial (Fase 3 - opcional)
# =====================================================
# Valores possiveis: judit | escavador | trackjud | (vazio = desabilitado)
JURIDICO_PROVIDER_COMERCIAL=

# Chave do provider comercial escolhido
JURIDICO_PROVIDER_API_KEY=

# =====================================================
# Domicilio Judicial Eletronico (Fase 4 - opcional)
# =====================================================
# Credenciais OAuth2 geradas no portal https://domicilio-eletronico.pdpj.jus.br
# Exige CNPJ/CPF credenciado com certificado digital no portal do CNJ.
DJE_CLIENT_ID=
DJE_CLIENT_SECRET=
DJE_BEHALF_OF_CPF=

# Certificado digital ICP-Brasil do Municipio (e-CNPJ).
# ATENCAO AO TIPO: apenas A1 (arquivo .pfx/.p12) permite operacao automatica.
# A3 (token fisico ou cartao) exige alguem plugado na maquina e NAO funciona.
# E o mesmo certificado ja usado nos demais sistemas da Prefeitura - nao e
# preciso emitir um so para o juridico.
# A senha fica SO no seu .env local, nunca no git, nunca em log.
DJE_CERT_PATH=
DJE_CERT_SENHA=

# Endpoints do DJe. Os padroes do codigo seguem o Manual DJe 3a Ed., mas o host
# do GeCli (gecli.cnj.jus.br) NAO resolvia em 02/09/2026 - o CNJ migrou a
# autenticacao. Confirme os enderecos corretos no credenciamento e defina aqui,
# sem precisar alterar codigo.
DJE_TOKEN_URL=
DJE_BASE_URL=
# GATE DE SEGURANCA: Mantenha vazio ou 'false' em desenvolvimento.
# Defina como 'true' SOMENTE em producao, apos revisao do advogado responsavel.
# Quando 'true', confirmar_leitura_intimacao tem EFEITO JURIDICO REAL e IRREVERSIVEL:
# inicia a contagem do prazo processual no CNJ. Qualquer outro valor = modo dry-run.
DJE_PERMITIR_CONFIRMACAO_LEITURA=false

# =====================================================
# Configuracoes de runtime
# =====================================================
JURIDICO_ENV=development
JURIDICO_LOG_LEVEL=INFO
JURIDICO_CACHE_TTL=300
JURIDICO_RATE_LIMIT=5
JURIDICO_HTTP_TIMEOUT=30.0
JURIDICO_MAX_RETRIES=3
