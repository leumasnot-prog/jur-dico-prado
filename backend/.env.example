# === Painel Jurídico Pradópolis — backend ===
# Copie para .env e preencha localmente. O .env NUNCA entra no git.

# Conexão Postgres. Em produção, a string do Neon (https://neon.tech).
# Em desenvolvimento, o container local.
DATABASE_URL=postgresql+asyncpg://postgres:senha@localhost:5432/pradopolis

# Segredo de assinatura dos tokens JWT. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NUNCA reutilize entre ambientes.
JWT_SECRET=troque-por-um-segredo-aleatorio-longo

# Identificação do ente para a varredura do DJEN.
JURIDICO_NOME_PARTE=PRADOPOLIS
JURIDICO_TERMOS_CONFIRMACAO=MUNICIPIO,PREFEITURA
JURIDICO_UF=SP

# Varredura automática: dias úteis neste horário (America/Sao_Paulo).
VARREDURA_HORA=06:00
VARREDURA_JANELA_DIAS=30
VARREDURA_ATIVA=true

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# === Hermes — notificação via Telegram (Task 3) ===
# Token do bot, criado no @BotFather. É SEGREDO: dá controle total do bot.
# Sem ele o serviço sobe normalmente, apenas não notifica.
TELEGRAM_BOT_TOKEN=

# Chat do grupo da Procuradoria. Adicione o bot ao grupo e leia o id em
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Grupos têm id negativo (ex.: -1001234567890).
TELEGRAM_CHAT_ID_GRUPO=

# Segredo do cabeçalho do webhook. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

TELEGRAM_HORA_RESUMO=08:00
TELEGRAM_SILENCIO_INICIO=20:00
TELEGRAM_SILENCIO_FIM=07:00

# URL pública do painel — vai nos links das mensagens e no registro do webhook.
PAINEL_BASE_URL=http://127.0.0.1:8100

HERMES_ATIVO=true
HERMES_DIAS_CRITICOS=3
HERMES_INTERVALO_ALERTAS_MIN=30

# === Acionamento externo por cron (hosts de plano gratuito) ===
# Sem isto, POST /cron/varredura e /cron/hermes ficam sempre fechados (403).
# Em produção no plano free, HERMES_ATIVO e VARREDURA_ATIVA ficam "false" e
# quem aciona as tarefas é o GitHub Actions — ver backend/DEPLOY.md, §7.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
