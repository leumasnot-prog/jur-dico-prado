# === Painel Jurídico Pradópolis — backend ===
# Copie para .env e preencha localmente. O .env NUNCA entra no git.

# Conexão Postgres. Em produção, a string do Neon (https://neon.tech).
# Em desenvolvimento, o container local.
DATABASE_URL=postgresql+asyncpg://postgres:senha@localhost:5432/pradopolis

# Segredo de assinatura dos tokens JWT. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NUNCA reutilize entre ambientes.
JWT_SECRET=troque-por-um-segredo-aleatorio-longo

# Identificação do ente para a varredura do DJEN.
JURIDICO_NOME_PARTE=PRADOPOLIS
JURIDICO_TERMOS_CONFIRMACAO=MUNICIPIO,PREFEITURA
JURIDICO_UF=SP

# Varredura automática: dias úteis neste horário (America/Sao_Paulo).
VARREDURA_HORA=06:00
VARREDURA_JANELA_DIAS=30
VARREDURA_ATIVA=true

# CORS
FRONTEND_ORIGIN=http://localhost:5173
